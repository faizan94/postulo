# Copy to deploy/nebius/.env.nebius (gitignored) or export before running scripts.
# Secrets for the *app* still live in the repo-root .env that deploy.sh uploads.

# Nebius project (nebius config get parent-id)
# PROJECT_ID=

# VM identity
VM_NAME=postulo
# cpu-d3 = non-GPU AMD EPYC; 2vcpu-8gb is enough for compose demo
PLATFORM=cpu-d3
PRESET=2vcpu-8gb
DISK_GIB=80
IMAGE_FAMILY=ubuntu24.04-driverless

# Optional: reuse an existing subnet instead of creating one
# SUBNET_ID=

# Path to SSH public key injected via cloud-init
# SSH_PUBKEY=~/.ssh/id_ed25519.pub

# SSH user created by cloud-init.yaml
SSH_USER=postulo

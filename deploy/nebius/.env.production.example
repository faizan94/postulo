# Postulo production settings for the Nebius VM. Placeholders only.
# Copy to deploy/nebius/.env.production (git-ignored), fill it in, then run deploy.sh with
#   --env-file deploy/nebius/.env.production
# deploy.sh copies it to <repo>/.env on the VM and sets NEXT_PUBLIC_API_URL, CORS_ORIGINS
# and SITE_ADDRESS from PUBLIC_URL. Do not set those three by hand.

# Public URL people open in the browser. No trailing slash.
#   No domain:  http://<VM public IP>        e.g. http://203.0.113.10
#   Domain:     https://<your domain>        e.g. https://postulo.example.com (DNS A record -> VM IP)
PUBLIC_URL=http://YOUR_VM_PUBLIC_IP

# Real searches need both keys and MOCK_MODE=false. MOCK_MODE=true runs on fake data.
MOCK_MODE=false

# Nebius Token Factory key (Token Factory console -> API keys)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_MODEL=nvidia/Nemotron-3.5-Super-VL
NEMOTRON_FAST_MODEL=nvidia/Nemotron-3_5-Lightning
NEMOTRON_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
OCR_ENABLED=true

# Tavily key (https://app.tavily.com, starts with tvly-)
TAVILY_API_KEY=

LOG_LEVEL=INFO
MAX_POSTINGS=10
# Inside the container: /app/data/postulo.db (the postulo-data volume). Keep this value.
DATABASE_URL=sqlite+aiosqlite:///./data/postulo.db
MAX_TAVILY_CREDITS_PER_RUN=20
MAX_LLM_CALLS_PER_RUN=15
RECENT_DAYS=45

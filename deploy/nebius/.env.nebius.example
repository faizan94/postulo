# Copy to deploy/nebius/.env.nebius (gitignored) or export before running scripts.
# App secrets (NEBIUS_API_KEY, TAVILY_API_KEY) stay in the repo-root .env.

# Nebius project (nebius config get parent-id)
# PROJECT_ID=
# REGION=uk-south2

# Reuse the project default subnet
# SUBNET_ID=

# Serverless AI endpoint
ENDPOINT_NAME=postulo
PLATFORM=cpu-d3
PRESET=2vcpu-8gb
DISK_SIZE=40Gi
REGISTRY_NAME=postulo
IMAGE_NAME=postulo
TAG=latest

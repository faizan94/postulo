# Postulo configuration. Copy to .env (never commit .env):
#   macOS/Linux/Git Bash:  cp .env.example .env
#   PowerShell:            Copy-Item .env.example .env
# Used by docker compose (env_file) and by the backend when run from backend/ (reads ../.env).

# ---------------------------------------------------------------------------
# Mock mode: true = endpoints return realistic fake data, no API keys needed.
# Set to false (and fill in the keys below) for real searches.
# ---------------------------------------------------------------------------
MOCK_MODE=true

# ---------------------------------------------------------------------------
# Nebius Token Factory (OpenAI-compatible API serving NVIDIA Nemotron)
# Create a key: Token Factory console -> API keys (it is shown only once).
# ---------------------------------------------------------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Main reasoning model (CV reading, scoring).
NEMOTRON_MODEL=nvidia/Nemotron-3.5-Super-VL
# Fast/cheap model for sub-agent steps (Nemotron 3.5 Lightning, listed on Token Factory).
NEMOTRON_FAST_MODEL=nvidia/Nemotron-3_5-Lightning

# ---------------------------------------------------------------------------
# Tavily web search: https://app.tavily.com (key starts with tvly-)
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Backend app settings
# ---------------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Max postings returned per search (1-20).
MAX_POSTINGS=10

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Backend URL as seen from the BROWSER. Inlined at build time (rebuild after changing).
NEXT_PUBLIC_API_URL=http://localhost:8000

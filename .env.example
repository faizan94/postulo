# Postulo configuration. Copy to .env (never commit .env):
#   macOS/Linux/Git Bash:  cp .env.example .env
#   PowerShell:            Copy-Item .env.example .env
# Used by docker compose (env_file) and by the backend when run from backend/ (reads ../.env).

# ---------------------------------------------------------------------------
# Mock mode: true = endpoints return realistic fake data, no API keys needed.
# Set to false (and fill in the keys below) for real searches.
# ---------------------------------------------------------------------------
MOCK_MODE=true

# ---------------------------------------------------------------------------
# Nebius Token Factory (OpenAI-compatible API serving NVIDIA Nemotron)
# Create a key: Token Factory console -> API keys (it is shown only once).
# ---------------------------------------------------------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Main model: planning and CV profile.
NEMOTRON_MODEL=nvidia/Nemotron-3.5-Super-VL
# Fast/cheap model for sub-agent steps (Nemotron 3.5 Lightning, listed on Token Factory).
NEMOTRON_FAST_MODEL=nvidia/Nemotron-3_5-Lightning
# Vision model: reads scans, photos and broken PDFs (OCR_ENABLED).
NEMOTRON_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=8000

# ---------------------------------------------------------------------------
# Tavily web search: https://app.tavily.com (key starts with tvly-)
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Backend app settings
# ---------------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Max postings returned per search (1-20).
MAX_POSTINGS=10
# SQLite file (relative to backend/ locally, /app in Docker).
DATABASE_URL=sqlite+aiosqlite:///./data/postulo.db
# Per-search budgets and freshness.
MAX_TAVILY_CREDITS_PER_RUN=20
MAX_LLM_CALLS_PER_RUN=15
RECENT_DAYS=45
# Reserved, not enforced yet.
POSTING_RECHECK_HOURS=24
COMPANY_CACHE_DAYS=30
# Read scans, photos and badly encoded PDFs with Nemotron vision.
OCR_ENABLED=true

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Backend URL as seen from the BROWSER. Inlined at build time (rebuild after changing).
NEXT_PUBLIC_API_URL=http://localhost:8000
